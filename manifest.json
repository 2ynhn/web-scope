{
  "manifest_version": 3,
  "name": "Web Scope",
  "version": "1.0.0",
  "description": "Web browsing utility toolkit",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Web Scope",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/fit-media.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-comic-viewer": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "만화 뷰어 열기/닫기"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "common/defaults.js",
        "content/fit-media.js",
        "content/media-nav.js",
        "content/comic-viewer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
